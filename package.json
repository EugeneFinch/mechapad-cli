{
  "name": "megapad",
  "version": "0.1.1",
  "description": "Open Multi-Model AI Control Surface & Native MCP Server — Run Claude Fable 5.1, GPT-6 Astra, DeepSeek V4.1 Flash, and Gemini 3.8 in parallel",
  "type": "module",
  "bin": {
    "megapad": "./dist/index.js",
    "megapad-mcp": "./dist/index.js",
    "pad": "./dist/index.js",
    "mecha": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@modelcontextprotocol/sdk && chmod +x dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EugeneFinch/mechapad-cli.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "codex",
    "ai-agent",
    "deepseek",
    "multi-model",
    "benchmark"
  ],
  "author": "Eugene Finch",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
